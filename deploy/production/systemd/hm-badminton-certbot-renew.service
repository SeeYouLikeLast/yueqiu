[Unit]
Description=Renew the short-lived HTTPS certificate for hm-badminton
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=oneshot
# Keep the hook out of Certbot's argument parsing.  systemd runs this only
# after a successful renewal, and an Nginx reload is harmless when no cert changed.
ExecStart=/opt/hm-badminton/certbot/bin/certbot renew --quiet
ExecStartPost=/usr/bin/systemctl reload nginx
