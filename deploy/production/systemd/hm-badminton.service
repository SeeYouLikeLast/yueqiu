[Unit]
Description=Yue Ge Qiu Spring Boot Backend
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=hmapp
Group=hmapp
WorkingDirectory=/opt/hm-badminton/backend
LogsDirectory=hm-badminton
EnvironmentFile=/etc/hm-badminton/app.env
ExecStart=/usr/bin/java -Drocketmq.log.root=/var/log/hm-badminton/rocketmqlogs -jar /opt/hm-badminton/backend/app.jar
SuccessExitStatus=143
Restart=always
RestartSec=8
TimeoutStopSec=30
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
