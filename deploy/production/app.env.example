# /etc/hm-badminton/app.env
# 该文件仅存放服务器密钥，权限应为 600，不能提交 Git。
# 2GB ECS 使用 prod,lite；升级到 4C8G 并启用 RocketMQ 时改回 prod。
SPRING_PROFILES_ACTIVE=prod,lite
JAVA_TOOL_OPTIONS=-Xms128m -Xmx384m

MYSQL_URL=jdbc:mysql://127.0.0.1:3307/hm_badminton?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
MYSQL_USERNAME=root
MYSQL_PASSWORD=replace-with-the-mysql-root-password
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
ROCKETMQ_NAME_SERVER=127.0.0.1:9876

MINIO_ENDPOINT=http://127.0.0.1:9000
# 改成真实域名。Nginx 将 /objects/ 反代到本机 MinIO。
MINIO_PUBLIC_ENDPOINT=https://your-domain.example/objects
MINIO_ACCESS_KEY=hmminioadmin
MINIO_SECRET_KEY=replace-with-the-minio-password
MINIO_BUCKET=hm-badminton

JWT_SECRET=replace-with-a-long-random-jwt-secret
AMAP_KEY=replace-with-your-amap-key
AI_DASHSCOPE_ENABLED=true
AI_DASHSCOPE_API_KEY=replace-with-your-dashscope-key
AI_MODEL=qwen-plus
MAIL_USERNAME=replace-with-your-qq-mail-address
MAIL_PASSWORD=replace-with-your-qq-mail-authorization-code
