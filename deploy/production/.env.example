# 生产 Docker 依赖仅监听 ECS 本机；公网只能访问 Nginx 的 80/443。
DOCKER_BIND_ADDRESS=127.0.0.1

MYSQL_IMAGE=mysql:8.4
REDIS_IMAGE=redis:7.4
MINIO_IMAGE=quay.io/minio/minio:latest
MINIO_CLIENT_IMAGE=quay.io/minio/mc:latest
ROCKETMQ_IMAGE=apache/rocketmq:5.3.2

# 使用随机高强度密码；实际 .env 不提交 Git。
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-password
MINIO_ROOT_USER=hmminioadmin
MINIO_ROOT_PASSWORD=replace-with-another-long-random-password
MINIO_BUCKET=hm-badminton
